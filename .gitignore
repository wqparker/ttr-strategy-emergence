# Training outputs
runs/*
# Linear-agent training runs (weights, per-game rows, evaluations) are kept, so
# analysis and best checkpoints travel with the repo. Dashboard PNGs and empty
# error logs are regenerable; the pre-pass-1 runs (v0, v1) are obsolete.
!runs/linear/
runs/linear/*
!runs/linear/pass1/
!runs/linear/pass2/
!runs/linear/pass3/
!runs/linear/pass4/
!runs/linear/pass5/
!runs/linear/pass6/
!runs/linear/pass7/
!runs/linear/pass8/
# Overnight logs and fresh-game re-scores (analysis behind PLAN.md)
!runs/linear/overnight-*.md
!runs/linear/rescore_*
runs/linear/pass*/dash/
runs/linear/pass*/*.err
runs/linear/pass*/*.tmp
# DQN runs, kept the same way (run JSON + networks in .pt)
!runs/dqn/
runs/dqn/*
!runs/dqn/pass*/
!runs/dqn/rescore_*
runs/dqn/pass*/dash/
runs/dqn/pass*/*.err
runs/dqn/pass*/*.tmp
checkpoints/
models/
wandb/
tensorboard/
*.zip

